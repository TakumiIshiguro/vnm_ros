<launch>
  <arg name="start_joy_node" default="true"/>
  <arg name="joy_dev" default="/dev/input/js1"/>
  <arg name="horizontal_axis" default="6"/>
  <arg name="fallback_horizontal_axis" default="0"/>
  <arg name="axis_threshold" default="0.5"/>
  <arg name="invert_axis" default="false"/>
  <arg name="straight_button" default="-1"/>
  <arg name="left_button" default="-1"/>
  <arg name="right_button" default="-1"/>

  <node if="$(arg start_joy_node)" pkg="joy" type="joy_node"
        name="vnm_joy" output="screen">
    <param name="dev" value="$(arg joy_dev)"/>
    <param name="deadzone" value="0.2"/>
    <param name="autorepeat_rate" value="20.0"/>
  </node>

  <node pkg="vnm_ros" type="controller_cmd_dir.py"
        name="vnm_controller_cmd_dir" output="screen" required="true">
    <param name="config_dir" value="$(find vnm_ros)/config"/>
    <param name="rate" value="10.0"/>
    <param name="stale_timeout" value="0.5"/>
    <param name="horizontal_axis" value="$(arg horizontal_axis)"/>
    <param name="fallback_horizontal_axis" value="$(arg fallback_horizontal_axis)"/>
    <param name="axis_threshold" value="$(arg axis_threshold)"/>
    <param name="invert_axis" value="$(arg invert_axis)"/>
    <param name="straight_button" value="$(arg straight_button)"/>
    <param name="left_button" value="$(arg left_button)"/>
    <param name="right_button" value="$(arg right_button)"/>
  </node>
</launch>
